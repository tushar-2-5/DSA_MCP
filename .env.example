# ==============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# ==============================================================================
# Neon PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[endpoint-id]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key for text-embedding-004
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================
# Secret key for web session & JWT token encryption (auto-generated if unset)
SECRET_KEY=your_secret_key_here_generate_with_python_-c_"import_secrets;print(secrets.token_hex(32))"

# Server Port and Transport Mode
PORT=8000
MCP_TRANSPORT=streamable-http
